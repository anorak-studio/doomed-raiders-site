---
import { getEntry } from 'astro:content';

const fr = await getEntry('site', 'fr');
const t = fr!.data;
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>404 — Doomed Raiders</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" type="image/png" href="/assets/favicon.png" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class="nf">
  <main class="wrap nf-main">
    <img src="/assets/logo-doomed-raiders.png" alt="Doomed Raiders" width="277" height="127" />
    <h1>{t.notFound.title}</h1>
    <p>{t.notFound.text}</p>
    <a class="btn btn-steam" href="/">{t.notFound.back}</a>
  </main>
</body>
</html>
